# LLM Arena environment example.
# Copy to .env and fill only deployment/local infrastructure values.
# Provider models, chat routing models, investment agent models, and KIS
# tenant credentials are managed through runtime_credentials + DB config
# via chat/settings UI. Do not duplicate those DB-overridden values here.

# Core
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BQ_DATASET=llm_arena
BQ_LOCATION=asia-northeast3

# Local runtime
ARENA_MODE=local
ARENA_LOCAL_DB_PATH=./data/arena.duckdb
ARENA_LOCAL_VECTOR_DIR=./data/chroma

# UI local development
ARENA_UI_AUTH_ENABLED=false
ARENA_UI_SETTINGS_ENABLED=true
PORT=8080

# Arena local/demo defaults
ARENA_BASE_CURRENCY=KRW
ARENA_SLEEVE_CAPITAL_KRW=1000000
ARENA_LOG_LEVEL=INFO
ARENA_UNIVERSE_RUN_TOP_N=400
ARENA_UNIVERSE_PER_EXCHANGE_CAP=200
ARENA_US_QUOTE_EXCHANGES=NAS,NYS

# Local model/vector cache
HF_HOME=./data/hf-cache
SENTENCE_TRANSFORMERS_HOME=./data/hf-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Macro data keys used by local runs and deploy scripts.
FRED_API_KEY=
ECOS_API_KEY=

# Local credentials default to ~/.llm-arena/credentials.json.
# Override only if you need a custom path.
# ARENA_LOCAL_CREDENTIALS_FILE=~/.llm-arena/credentials.json

# Optional one-off closed-market slow-prep test bypass.
# Keep false/empty for normal runs. Split Cloud Run slow-prep jobs inject this
# automatically from scripts/deploy_cloud_run_job.sh.
# ARENA_SHARED_PREP_FORCE_MARKET_CLOSED=false

# Optional single-tenant CLI fallback only. Prefer chat/settings UI.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Optional KIS fallback only. Prefer chat/settings UI local credential storage
# or GCP Secret Manager/runtime_credentials.
# KIS_ENV=demo
# KIS_PAPER_API_KEY=
# KIS_PAPER_API_SECRET=
# KIS_ACCOUNT_NO=
# KIS_ACCOUNT_PRODUCT_CODE=01
