# Local quickstart backend
ARENA_MODE=local
ARENA_LOCAL_DB_PATH=./data/arena.duckdb
ARENA_LOCAL_VECTOR_DIR=./data/chroma
KIS_TOKEN_CACHE_BACKEND=file

# Pick only providers you have keys for.
ARENA_AGENT_IDS=gpt

# LLM credentials. Set at least one.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Paper/demo defaults
ARENA_TRADING_MODE=paper
ARENA_DISTRIBUTION_MODE=simulated_only
ARENA_ALLOW_LIVE_TRADING=false
ARENA_SLEEVE_CAPITAL_KRW=1000000
ARENA_USD_KRW_RATE=1380

# Optional: KIS/OpenTrading credentials for real local market backfill.
# KIS_ENV=demo
# KIS_PAPER_API_KEY=
# KIS_PAPER_API_SECRET=
# KIS_ACCOUNT_NO=
# KIS_ACCOUNT_PRODUCT_CODE=01
