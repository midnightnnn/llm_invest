# Local quickstart backend
ARENA_MODE=local
ARENA_LOCAL_DB_PATH=./data/arena.duckdb
ARENA_LOCAL_VECTOR_DIR=./data/chroma
KIS_TOKEN_CACHE_BACKEND=file

# Local UI/settings
ARENA_UI_AUTH_ENABLED=false
ARENA_UI_SETTINGS_ENABLED=true
PORT=8080

# Model API keys and selected models are stored through chat/settings UI in
# ~/.llm-arena/credentials.json + local DuckDB runtime config.
# Optional single-tenant CLI fallback only:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Paper/demo defaults
ARENA_TRADING_MODE=paper
ARENA_DISTRIBUTION_MODE=simulated_only
ARENA_ALLOW_LIVE_TRADING=false
ARENA_SLEEVE_CAPITAL_KRW=1000000
ARENA_USD_KRW_RATE=1380

# Macro data keys are process-level env vars, not tenant DB overrides.
FRED_API_KEY=
ECOS_API_KEY=

# Optional: KIS/OpenTrading fallback for direct local CLI market backfill.
# This does not auto-create ~/.llm-arena/credentials.json. Chat/settings UI
# writes tenant KIS credentials to that file when you save them there.
# KIS_ENV=demo
# KIS_PAPER_API_KEY=
# KIS_PAPER_API_SECRET=
# KIS_ACCOUNT_NO=
# KIS_ACCOUNT_PRODUCT_CODE=01
