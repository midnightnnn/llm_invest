<style>
  .investment-chat-shell {
    height: calc(100dvh - var(--mobile-topbar-h));
    min-height: 0;
    position: relative;
  }
  .investment-chat-workspace {
    position: relative;
    min-width: 0;
    min-height: 0;
  }
  .investment-chat-frame {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 0;
  }
  @media (min-width: 768px) {
    .investment-chat-shell {
      height: 100vh;
      min-height: 560px;
    }
  }
</style>
<section class="investment-chat-shell flex overflow-hidden bg-white">
  {% if iframe_src %}
  <script>
    (function initializeAdkSidePanelClosed() {
      try {
        window.localStorage.setItem('adk-side-panel-visible', 'false');
        window.localStorage.setItem('adk-theme-preference', 'light');
      } catch (_err) {}
    })();
  </script>
  <div class="investment-chat-workspace flex min-w-0 flex-1 flex-col">
    <iframe
      src="{{ iframe_src }}"
      title="투자챗봇"
      class="investment-chat-frame min-h-0 flex-1 border-0"
      loading="eager"
      referrerpolicy="same-origin"
      data-adk-chat-frame
    ></iframe>
  </div>
  <aside
    class="pointer-events-none fixed bottom-4 right-4 z-40 hidden w-[min(420px,calc(100vw-2rem))]"
    data-order-draft-panel
  >
    <div class="pointer-events-auto rounded-lg border border-ink-200 bg-white p-4 shadow-xl">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Order Approval</p>
          <h3 class="mt-1 truncate text-sm font-bold text-ink-900" data-order-draft-title></h3>
        </div>
        <button type="button" class="rounded-md px-2 py-1 text-xs text-ink-500 hover:bg-ink-50" data-order-draft-close>닫기</button>
      </div>
      <dl class="mt-3 grid grid-cols-2 gap-2 text-xs">
        <div>
          <dt class="text-ink-400">금액</dt>
          <dd class="font-semibold text-ink-800" data-order-draft-notional></dd>
        </div>
        <div>
          <dt class="text-ink-400">범위</dt>
          <dd class="font-semibold text-ink-800" data-order-draft-scope></dd>
        </div>
      </dl>
      <p class="mt-3 rounded-md bg-amber-50 px-3 py-2 text-xs leading-relaxed text-amber-800" data-order-draft-risk></p>
      <button
        type="button"
        class="mt-3 h-10 w-full rounded-md bg-ink-900 px-3 text-sm font-semibold text-white hover:bg-ink-800 disabled:cursor-not-allowed disabled:bg-ink-300"
        data-order-draft-submit
      >주문 승인</button>
      <p class="mt-2 hidden text-xs text-ink-500" data-order-draft-status></p>
    </div>
  </aside>
  <aside
    class="pointer-events-none fixed bottom-4 left-4 z-40 hidden w-[min(440px,calc(100vw-2rem))]"
    data-config-draft-panel
  >
    <div class="pointer-events-auto rounded-lg border border-blue-200 bg-white p-4 shadow-xl">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">Config Approval</p>
          <h3 class="mt-1 truncate text-sm font-bold text-ink-900" data-config-draft-title></h3>
        </div>
        <button type="button" class="rounded-md px-2 py-1 text-xs text-ink-500 hover:bg-ink-50" data-config-draft-close>닫기</button>
      </div>
      <p class="mt-3 rounded-md bg-blue-50 px-3 py-2 text-xs leading-relaxed text-blue-900" data-config-draft-summary></p>
      <ul class="mt-3 max-h-28 space-y-1 overflow-y-auto text-xs text-ink-600" data-config-draft-diffs></ul>
      <button
        type="button"
        class="mt-3 h-10 w-full rounded-md bg-blue-700 px-3 text-sm font-semibold text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-ink-300"
        data-config-draft-apply
      >설정 변경 승인</button>
      <p class="mt-2 hidden text-xs text-ink-500" data-config-draft-status></p>
    </div>
  </aside>
  {% else %}
  <div class="flex flex-1 items-center justify-center px-6">
    <div class="max-w-md rounded-lg border border-amber-200 bg-amber-50 p-5 text-sm leading-relaxed text-amber-900">
      등록된 LLM API key가 없거나 챗봇 모델이 설정되지 않았습니다. 환경설정 → 에이전트 탭에서 모델을 지정해주세요.
    </div>
  </div>
  {% endif %}
</section>
{% if iframe_src %}
<script>
  (function() {
    function adkFrame() {
      return document.querySelector('[data-adk-chat-frame]');
    }

    function adkFrameDocument() {
      var frame = adkFrame();
      try {
        return frame && (frame.contentDocument || (frame.contentWindow && frame.contentWindow.document));
      } catch (_err) {
        return null;
      }
    }

    function removeStaleAdkDrawerStabilizer(attempt) {
      var tries = Number(attempt || 0);
      var doc = adkFrameDocument();
      if (!doc || !doc.head) {
        if (tries < 40) {
          window.setTimeout(function() { removeStaleAdkDrawerStabilizer(tries + 1); }, 250);
        }
        return false;
      }
      var stale = doc.getElementById('arena-adk-drawer-stabilizer');
      if (stale && stale.parentNode) {
        stale.parentNode.removeChild(stale);
      }
      return true;
    }

    function installWhenReady(attempt) {
      var tries = Number(attempt || 0);
      var doc = adkFrameDocument();
      if (doc && doc.head) {
        removeStaleAdkDrawerStabilizer(0);
        return;
      }
      if (tries < 40) {
        window.setTimeout(function() { installWhenReady(tries + 1); }, 250);
      }
    }

    var frame = adkFrame();
    if (frame) {
      frame.addEventListener('load', function() {
        installWhenReady(0);
      });
      installWhenReady(0);
    }
  })();

  (function() {
    var lists = Array.prototype.slice.call(document.querySelectorAll('[data-chat-session-list]'));
    var statuses = Array.prototype.slice.call(document.querySelectorAll('[data-chat-session-status]'));
    if (!lists.length) return;

    var appName = {{ chat_session_app_name | tojson }};
    var userId = {{ chat_session_user_id | tojson }};
    var iframeBaseSrc = {{ iframe_src | tojson }};
    var currentSessionId = '';
    var lastListLoadAt = 0;

    function frame() {
      return document.querySelector('[data-adk-chat-frame]');
    }

    function setStatus(text) {
      statuses.forEach(function(status) {
        status.textContent = text || '';
      });
    }

    function withIframeParams(params) {
      var url = new URL(iframeBaseSrc, window.location.origin);
      Object.keys(params || {}).forEach(function(key) {
        var value = params[key];
        if (value === null || value === undefined || value === '') {
          url.searchParams.delete(key);
        } else {
          url.searchParams.set(key, value);
        }
      });
      url.searchParams.set('_session_v', String(Date.now()));
      return url.pathname + url.search + url.hash;
    }

    function closeMainSidebarOnMobile() {
      if (window.innerWidth >= 768) return;
      var sidebar = document.getElementById('arena-sidebar');
      var backdrop = document.getElementById('sidebar-backdrop');
      if (sidebar) sidebar.classList.remove('open');
      if (backdrop) backdrop.classList.remove('open');
    }

    function setSessionTreeOpen(open) {
      document.querySelectorAll('[data-chat-session-nav]').forEach(function(nav) {
        nav.dataset.open = open ? 'true' : 'false';
      });
      document.querySelectorAll('[data-chat-session-tree-toggle]').forEach(function(button) {
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        button.setAttribute('aria-label', open ? '투자챗봇 대화 목록 닫기' : '투자챗봇 대화 목록 열기');
      });
    }

    function sessionTitle(session) {
      var metadata = session && session.state && session.state.__session_metadata__;
      var title = metadata && metadata.displayName;
      title = String(title || '').trim();
      if (title) return title;
      var id = String(session && session.id || '').trim();
      return id ? ('대화 ' + id.slice(0, 8)) : '새 대화';
    }

    function sessionTime(session) {
      var raw = Number(session && (session.lastUpdateTime || session.updateTime || session.createTime) || 0);
      if (!isFinite(raw) || raw <= 0) return '';
      var millis = raw > 1000000000000 ? raw : raw * 1000;
      try {
        return new Intl.DateTimeFormat('ko-KR', {
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        }).format(new Date(millis));
      } catch (_err) {
        return '';
      }
    }

    function setActiveSession(sessionId) {
      currentSessionId = String(sessionId || '');
      document.querySelectorAll('[data-chat-session-id]').forEach(function(item) {
        var active = item.getAttribute('data-chat-session-id') === currentSessionId;
        item.setAttribute('aria-current', active ? 'page' : 'false');
        item.classList.toggle('bg-white', active);
        item.classList.toggle('shadow-sm', active);
        item.classList.toggle('text-ink-950', active);
      });
    }

    function renderSessions(sessions) {
      var rows = (sessions || []).slice().sort(function(a, b) {
        return Number(b.lastUpdateTime || 0) - Number(a.lastUpdateTime || 0);
      });
      lists.forEach(function(list) {
        list.innerHTML = '';
        if (!rows.length) {
          var empty = document.createElement('p');
          empty.className = 'px-2 py-2 text-xs text-ink-500';
          empty.textContent = '저장된 대화가 없습니다.';
          list.appendChild(empty);
          return;
        }
        rows.forEach(function(session) {
          var id = String(session && session.id || '').trim();
          if (!id) return;
          var button = document.createElement('button');
          button.type = 'button';
          button.className = list.closest('[data-chat-session-nav]')
            ? 'chat-session-item'
            : 'mb-1 flex w-full flex-col rounded-md px-3 py-2 text-left text-sm text-ink-700 hover:bg-white';
          button.setAttribute('data-chat-session-id', id);
          button.setAttribute('aria-current', 'false');

          var title = document.createElement('span');
          title.className = list.closest('[data-chat-session-nav]') ? 'chat-session-title' : 'w-full truncate font-semibold';
          title.textContent = sessionTitle(session);
          button.appendChild(title);

          var time = sessionTime(session);
          if (time) {
            var meta = document.createElement('span');
            meta.className = list.closest('[data-chat-session-nav]') ? 'chat-session-meta' : 'mt-1 text-[11px] text-ink-400';
            meta.textContent = time;
            button.appendChild(meta);
          }

          button.addEventListener('click', function() {
            openSession(id);
          });
          list.appendChild(button);
        });
      });
      setActiveSession(currentSessionId);
    }

    function loadChatSessions(force) {
      if (!appName || !userId) return Promise.resolve();
      var now = Date.now();
      if (!force && now - lastListLoadAt < 15000) return Promise.resolve();
      lastListLoadAt = now;
      setStatus('동기화 중');
      var url = '/investment-chat/adk/apps/' + encodeURIComponent(appName) + '/users/' + encodeURIComponent(userId) + '/sessions';
      return fetch(url, {credentials: 'same-origin'})
        .then(function(resp) {
          if (!resp.ok) throw new Error('session list failed');
          return resp.json();
        })
        .then(function(payload) {
          var sessions = Array.isArray(payload) ? payload : (payload && payload.items || []);
          renderSessions(sessions);
          setStatus(sessions.length ? (sessions.length + '개') : '');
        })
        .catch(function() {
          setStatus('불러오기 실패');
        });
    }

    function openSession(sessionId) {
      var targetFrame = frame();
      if (!targetFrame) return;
      setActiveSession(sessionId);
      targetFrame.src = withIframeParams({session: sessionId, userId: userId});
      closeMainSidebarOnMobile();
    }

    function startNewSession() {
      var targetFrame = frame();
      if (!targetFrame) return;
      setActiveSession('');
      targetFrame.src = withIframeParams({session: '', userId: userId});
      closeMainSidebarOnMobile();
    }

    function syncActiveSessionFromFrame() {
      var targetFrame = frame();
      try {
        var href = targetFrame && targetFrame.contentWindow && targetFrame.contentWindow.location.href;
        if (!href) return;
        var url = new URL(href);
        var sessionId = url.searchParams.get('session') || '';
        if (sessionId && sessionId !== currentSessionId) {
          setActiveSession(sessionId);
          loadChatSessions(true);
        }
      } catch (_err) {}
    }

    window.loadChatSessions = loadChatSessions;
    document.querySelectorAll('[data-chat-session-new]').forEach(function(button) {
      button.addEventListener('click', startNewSession);
    });
    document.querySelectorAll('[data-chat-session-refresh]').forEach(function(button) {
      button.addEventListener('click', function() { loadChatSessions(true); });
    });
    document.querySelectorAll('[data-chat-session-tree-toggle]').forEach(function(button) {
      button.addEventListener('click', function() {
        var expanded = button.getAttribute('aria-expanded') === 'true';
        setSessionTreeOpen(!expanded);
      });
    });
    var targetFrame = frame();
    if (targetFrame) {
      targetFrame.addEventListener('load', function() {
        syncActiveSessionFromFrame();
      });
    }
    loadChatSessions(true);
    window.setInterval(syncActiveSessionFromFrame, 2000);
    window.addEventListener('focus', function() { loadChatSessions(false); });
  })();

  (function() {
    var tenant = {{ tenant | tojson }};
    var panel = document.querySelector('[data-order-draft-panel]');
    if (!panel) return;
    var title = panel.querySelector('[data-order-draft-title]');
    var notional = panel.querySelector('[data-order-draft-notional]');
    var scope = panel.querySelector('[data-order-draft-scope]');
    var risk = panel.querySelector('[data-order-draft-risk]');
    var submit = panel.querySelector('[data-order-draft-submit]');
    var status = panel.querySelector('[data-order-draft-status]');
    var close = panel.querySelector('[data-order-draft-close]');
    var activeToken = '';
    var dismissed = {};

    function fmtKrw(value) {
      var number = Number(value || 0);
      if (!isFinite(number)) return '-';
      return Math.round(number).toLocaleString('ko-KR') + '원';
    }

    function setStatus(text) {
      if (!status) return;
      status.textContent = text || '';
      status.classList.toggle('hidden', !text);
    }

    function submitResultMessage(body) {
      var reportMessage = body && body.execution_report && body.execution_report.message;
      return body && (body.message || body.error) || reportMessage || ('status=' + (body && body.status || 'unknown'));
    }

    function isAdkChatBusy(doc) {
      return !!(
        doc &&
        (
          doc.querySelector('mat-progress-bar') ||
          doc.querySelector('.agent-loading-indicator') ||
          doc.querySelector('[role="progressbar"]')
        )
      );
    }

    function deliverOrderResultToChat(text, attempt) {
      var message = String(text || '').trim();
      if (!message) return false;
      var tries = Number(attempt || 0);
      var frame = document.querySelector('[data-adk-chat-frame]');
      if (!frame) return false;
      var doc = null;
      try {
        doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
      } catch (_err) {
        return false;
      }
      if (isAdkChatBusy(doc)) {
        if (tries < 80) {
          window.setTimeout(function() { deliverOrderResultToChat(message, tries + 1); }, 500);
        }
        return false;
      }
      var textarea = doc && doc.querySelector('textarea.chat-input-box');
      var sendButton = doc && doc.querySelector('button.send-message-btn');
      if (!textarea || !sendButton) {
        if (tries < 80) {
          window.setTimeout(function() { deliverOrderResultToChat(message, tries + 1); }, 500);
        }
        return false;
      }
      var EventCtor = (doc.defaultView && doc.defaultView.Event) || Event;
      textarea.focus();
      textarea.value = message;
      textarea.dispatchEvent(new EventCtor('input', {bubbles: true}));
      textarea.dispatchEvent(new EventCtor('change', {bubbles: true}));
      sendButton.click();
      return true;
    }

    function deliverSubmitResult(body) {
      return deliverOrderResultToChat(body && body.chat_delivery_text);
    }

    function renderDraft(draft) {
      if (!draft || !draft.approval_token) return;
      activeToken = draft.approval_token;
      var intent = draft.intent || {};
      var riskObj = draft.risk || {};
      var side = String(intent.side || '').toUpperCase();
      title.textContent = [intent.ticker, side, intent.quantity ? ('x ' + intent.quantity) : ''].filter(Boolean).join(' ');
      notional.textContent = fmtKrw(draft.notional_krw || intent.price_krw * intent.quantity);
      scope.textContent = draft.scope || 'account';
      var hits = riskObj.policy_hits || [];
      risk.textContent = draft.submittable ? '리스크 검증 통과. 버튼을 누르면 저장된 주문 초안을 제출합니다.' : ('제출 불가: ' + (hits.length ? hits.join(', ') : draft.status));
      submit.disabled = !draft.submittable;
      setStatus('');
      panel.classList.remove('hidden');
    }

    function pollDrafts() {
      fetch('/investment-chat/order-drafts?tenant_id=' + encodeURIComponent(tenant), {credentials: 'same-origin'})
        .then(function(resp) { return resp.ok ? resp.json() : null; })
        .then(function(payload) {
          var drafts = payload && payload.drafts || [];
          var draft = drafts.find(function(item) {
            return item && item.approval_token && !dismissed[item.approval_token] && ['draft', 'risk_rejected'].indexOf(String(item.status || '')) >= 0;
          });
          if (draft) renderDraft(draft);
        })
        .catch(function() {});
    }

    if (close) {
      close.addEventListener('click', function() {
        if (activeToken) dismissed[activeToken] = true;
        panel.classList.add('hidden');
      });
    }
    if (submit) {
      submit.addEventListener('click', function() {
        if (!activeToken || submit.disabled) return;
        submit.disabled = true;
        setStatus('제출 중...');
        fetch('/investment-chat/order-drafts/' + encodeURIComponent(activeToken) + '/submit?tenant_id=' + encodeURIComponent(tenant), {
          method: 'POST',
          credentials: 'same-origin'
        })
          .then(function(resp) { return resp.json().then(function(body) { return {ok: resp.ok, body: body}; }); })
          .then(function(result) {
            var body = result.body || {};
            if (body.status === 'submitted' || body.status === 'already_submitted') {
              setStatus(body.status === 'already_submitted' ? '이미 제출된 주문입니다.' : '제출 완료');
              deliverSubmitResult(body);
              dismissed[activeToken] = true;
              window.setTimeout(function() { panel.classList.add('hidden'); }, 1200);
            } else {
              submit.disabled = false;
              deliverSubmitResult(body);
              setStatus('제출 실패: ' + submitResultMessage(body));
            }
          })
          .catch(function() {
            submit.disabled = false;
            setStatus('제출 실패');
          });
      });
    }

    pollDrafts();
    window.setInterval(pollDrafts, 2500);
  })();
</script>
<script>
  (function() {
    var tenant = {{ tenant | tojson }};
    var panel = document.querySelector('[data-config-draft-panel]');
    if (!panel) return;
    var title = panel.querySelector('[data-config-draft-title]');
    var summary = panel.querySelector('[data-config-draft-summary]');
    var diffs = panel.querySelector('[data-config-draft-diffs]');
    var apply = panel.querySelector('[data-config-draft-apply]');
    var status = panel.querySelector('[data-config-draft-status]');
    var close = panel.querySelector('[data-config-draft-close]');
    var activeToken = '';
    var dismissed = {};

    function setConfigStatus(text) {
      if (!status) return;
      status.textContent = text || '';
      status.classList.toggle('hidden', !text);
    }

    function renderValue(value) {
      if (value === null || value === undefined || value === '') return '-';
      if (typeof value === 'object') {
        try { return JSON.stringify(value); } catch (_err) { return String(value); }
      }
      return String(value);
    }

    function deliverConfigResultToChat(text, attempt) {
      var message = String(text || '').trim();
      if (!message) return false;
      var tries = Number(attempt || 0);
      var frame = document.querySelector('[data-adk-chat-frame]');
      var doc = null;
      try {
        doc = frame && (frame.contentDocument || (frame.contentWindow && frame.contentWindow.document));
      } catch (_err) {
        return false;
      }
      var textarea = doc && doc.querySelector('textarea.chat-input-box');
      var sendButton = doc && doc.querySelector('button.send-message-btn');
      if (!textarea || !sendButton) {
        if (tries < 80) {
          window.setTimeout(function() { deliverConfigResultToChat(message, tries + 1); }, 500);
        }
        return false;
      }
      var EventCtor = (doc.defaultView && doc.defaultView.Event) || Event;
      textarea.focus();
      textarea.value = message;
      textarea.dispatchEvent(new EventCtor('input', {bubbles: true}));
      textarea.dispatchEvent(new EventCtor('change', {bubbles: true}));
      sendButton.click();
      return true;
    }

    function renderConfigDraft(draft) {
      if (!draft || !draft.approval_token) return;
      activeToken = draft.approval_token;
      title.textContent = draft.scope ? (draft.scope + ' 설정 변경') : '설정 변경';
      summary.textContent = draft.summary || '설정 변경 초안';
      diffs.innerHTML = '';
      (draft.diffs || []).slice(0, 8).forEach(function(diff) {
        var li = document.createElement('li');
        li.className = 'rounded bg-ink-50 px-2 py-1';
        li.textContent = String(diff.field || 'field') + ': ' + renderValue(diff.before) + ' -> ' + renderValue(diff.after);
        diffs.appendChild(li);
      });
      apply.disabled = !draft.submittable;
      setConfigStatus('');
      panel.classList.remove('hidden');
    }

    function pollConfigDrafts() {
      fetch('/investment-chat/config-drafts?tenant_id=' + encodeURIComponent(tenant), {credentials: 'same-origin'})
        .then(function(resp) { return resp.ok ? resp.json() : null; })
        .then(function(payload) {
          var drafts = payload && payload.drafts || [];
          var draft = drafts.find(function(item) {
            return item && item.approval_token && !dismissed[item.approval_token] && String(item.status || '') === 'draft';
          });
          if (draft) renderConfigDraft(draft);
        })
        .catch(function() {});
    }

    if (close) {
      close.addEventListener('click', function() {
        if (activeToken) dismissed[activeToken] = true;
        panel.classList.add('hidden');
      });
    }
    if (apply) {
      apply.addEventListener('click', function() {
        if (!activeToken || apply.disabled) return;
        apply.disabled = true;
        setConfigStatus('적용 중...');
        fetch('/investment-chat/config-drafts/' + encodeURIComponent(activeToken) + '/apply?tenant_id=' + encodeURIComponent(tenant), {
          method: 'POST',
          credentials: 'same-origin'
        })
          .then(function(resp) { return resp.json().then(function(body) { return {ok: resp.ok, body: body}; }); })
          .then(function(result) {
            var body = result.body || {};
            if (body.status === 'applied' || body.status === 'already_applied') {
              setConfigStatus(body.status === 'already_applied' ? '이미 적용된 설정입니다.' : '적용 완료');
              deliverConfigResultToChat(body.chat_delivery_text);
              dismissed[activeToken] = true;
              window.setTimeout(function() { panel.classList.add('hidden'); }, 1200);
            } else {
              apply.disabled = false;
              deliverConfigResultToChat(body.chat_delivery_text);
              setConfigStatus('적용 실패: ' + (body.error || body.message || body.status || 'unknown'));
            }
          })
          .catch(function() {
            apply.disabled = false;
            setConfigStatus('적용 실패');
          });
      });
    }

    pollConfigDrafts();
    window.setInterval(pollConfigDrafts, 2500);
  })();
</script>
{% endif %}
