          setBlockVisible(modelFields, false);
          setCredentialStatus(err && err.message || '모델 조회에 실패했습니다.');
        })
        .finally(function() {
          if (lookupModelButton) lookupModelButton.disabled = false;
        });
    }

    function setConfirmVisible(visible) {
      if (!confirmField) return;
      confirmField.classList.toggle('hidden', !visible);
      confirmField.classList.toggle('flex', visible);
    }

    function syncKisEnvFields() {
      var env = kisEnv && kisEnv.value === 'real' ? 'real' : 'demo';
      var showSecrets = activeKind === 'kis_account' && activeAction !== 'delete';
      setBlockVisible(kisPaperFields, showSecrets && env !== 'real');
      setBlockVisible(kisRealFields, showSecrets && env === 'real');
    }

    if (kisEnv) {
      kisEnv.addEventListener('change', syncKisEnvFields);
    }

    function renderCredentialDraft(draft) {
      if (!draft || !draft.approval_token) return;
      if (activeToken === draft.approval_token && !panel.classList.contains('hidden')) return;
      activeToken = draft.approval_token;
      activeAction = String(draft.action || '').toLowerCase();
      activeKind = String(draft.credential_kind || (draft.provider ? 'model_key' : 'kis_account')).toLowerCase();
      activeProvider = String(draft.provider || '').toLowerCase();
      var isKis = activeKind === 'kis_account';
      var label = isKis ? 'KIS' : (draft.provider_label || draft.provider || 'provider');
      title.textContent = activeAction === 'delete' ? (label + ' key 삭제') : (label + ' key 저장');
      summary.textContent = draft.summary || 'Credential request';
      if (helpText) {
        helpText.textContent = isKis
          ? 'KIS Developers에서 API 신청 후 계좌번호와 APP KEY / SECRET을 이 창에만 입력하세요.'
          : '발급 페이지에서 API key를 만든 뒤 이 창에만 입력하세요.';
      }
      if (helpLink) {
        helpLink.href = isKis ? kisHelpUrl : (helpMap[draft.provider] || 'https://platform.openai.com/api-keys');
        helpLink.textContent = isKis ? 'KIS Developers 열기' : 'API key 발급';
      }
      setBlockVisible(keyField, !isKis && activeAction !== 'delete');
      setBlockVisible(lookupModelButton, !isKis && activeAction !== 'delete');
      setBlockVisible(modelFields, false);
      setBlockVisible(kisFields, isKis);
      setConfirmVisible(activeAction === 'delete');
      if (confirmCopy) {
        confirmCopy.textContent = isKis
          ? '입력한 KIS 계좌의 저장된 API key를 삭제합니다.'
          : '이 provider의 저장된 LLM API key를 삭제합니다.';
      }
      if (kisEnv) kisEnv.value = draft.env === 'real' ? 'real' : 'demo';
      if (apiKey) apiKey.value = '';
      if (!isKis && activeAction !== 'delete') {
        fillModelSelect(advisorModel, [], draft.model || '');
        fillModelSelect(cheapModel, [], draft.cheap_model || draft.router_model || '');
      }
      if (kisAccountNo) kisAccountNo.value = '';
      kisSecretInputs.forEach(function(input) { input.value = ''; });
      if (confirm) confirm.checked = false;
      syncKisEnvFields();
      if (apply) apply.textContent = activeAction === 'delete' ? '삭제 승인' : (isKis ? '저장' : '저장 후 재시작');
      setCredentialStatus('');
      panel.classList.remove('hidden');
    }

    function pollCredentialDrafts() {
      fetch('/investment-chat/credential-drafts?tenant_id=' + encodeURIComponent(tenant), {credentials: 'same-origin'})
        .then(function(resp) { return resp.ok ? resp.json() : null; })
        .then(function(payload) {
          var drafts = payload && payload.drafts || [];
          var draft = drafts.find(function(item) {
            if (!item || !item.approval_token || dismissed[item.approval_token] || String(item.status || '') !== 'draft') return false;
            var createdAt = Date.parse(item.created_at || '');
            if (isFinite(createdAt) && createdAt < credentialDraftPageLoadedAt) return false;
            return true;
          });
          if (draft) renderCredentialDraft(draft);
        })
        .catch(function() {});
    }

    if (close) {
      close.addEventListener('click', function() {
        if (activeToken) dismissed[activeToken] = true;
        panel.classList.add('hidden');
      });
    }
    if (lookupModelButton) {
      lookupModelButton.addEventListener('click', lookupCredentialModels);
    }
    if (apiKey) {
      apiKey.addEventListener('input', function() {
        if (activeKind === 'model_key' && activeAction !== 'delete') {
          fillModelSelect(advisorModel, [], '');
          fillModelSelect(cheapModel, [], '');
          setBlockVisible(modelFields, false);
          setCredentialStatus('');
        }
      });
    }
    if (form) {
      form.addEventListener('submit', function(event) {
        event.preventDefault();
        if (!activeToken || !apply) return;
        apply.disabled = true;
        setCredentialStatus(activeAction === 'delete' ? '삭제 중...' : '저장 중...');
        var data = new FormData(form);
        if (activeKind === 'model_key' && activeAction !== 'delete' && ((advisorModel && advisorModel.disabled) || (cheapModel && cheapModel.disabled))) {
          apply.disabled = false;
          setCredentialStatus('모델 조회 후 저장할 모델을 선택하세요.');
          return;
        }
        if (activeKind === 'kis_account') {
          data.delete('api_key');
        }
        if (activeAction === 'delete') {
          if (!confirm || !confirm.checked) {
            apply.disabled = false;
            setCredentialStatus('삭제 확인 체크가 필요합니다.');
            return;
          }
          data.set('confirmed', 'true');
          data.delete('api_key');
        }
        fetch('/investment-chat/credential-drafts/' + encodeURIComponent(activeToken) + '/apply', {
          method: 'POST',
          credentials: 'same-origin',
          body: data
        })
          .then(function(resp) { return resp.json().then(function(body) { return {ok: resp.ok, body: body}; }); })
          .then(function(result) {
            var body = result.body || {};
            if (body.status === 'applied' || body.status === 'deleted') {
              setCredentialStatus(body.status === 'deleted' ? '삭제 완료' : '저장 완료');
              deliverCredentialResultToChat(body.chat_delivery_text);
              dismissed[activeToken] = true;
              window.setTimeout(function() {
                panel.classList.add('hidden');
                if (body.reload_url) window.location.href = body.reload_url;
              }, 1200);
            } else {
              apply.disabled = false;
              deliverCredentialResultToChat(body.chat_delivery_text);
              setCredentialStatus('처리 실패: ' + (body.error || body.message || body.status || 'unknown'));
            }
          })
          .catch(function() {
            apply.disabled = false;
            setCredentialStatus('처리 실패');
          });
      });
    }

    pollCredentialDrafts();
    window.setInterval(pollCredentialDrafts, 2500);
  })();
</script>
{% endif %}
