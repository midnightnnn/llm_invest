<style>
  .investment-chat-shell {
    height: calc(100dvh - var(--mobile-topbar-h));
    min-height: 0;
    position: relative;
  }
  .investment-chat-workspace {
    position: relative;
    min-width: 0;
    min-height: 0;
  }
  .investment-chat-frame {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 0;
  }
  @media (min-width: 768px) {
    .investment-chat-shell {
      height: 100vh;
      min-height: 560px;
    }
  }
</style>
<section class="investment-chat-shell flex overflow-hidden bg-white">
  {% if iframe_src %}
  <script>
    (function initializeAdkSidePanelClosed() {
      try {
        window.localStorage.setItem('adk-side-panel-visible', 'false');
        window.localStorage.setItem('adk-theme-preference', 'light');
      } catch (_err) {}
    })();
  </script>
  <div class="investment-chat-workspace flex min-w-0 flex-1 flex-col">
    <iframe
      src="{{ iframe_src }}"
      title="투자챗봇"
      class="investment-chat-frame min-h-0 flex-1 border-0"
      loading="eager"
      referrerpolicy="same-origin"
      data-adk-chat-frame
    ></iframe>
  </div>
  <aside
    class="pointer-events-none fixed bottom-4 right-4 z-40 hidden w-[min(420px,calc(100vw-2rem))]"
    data-order-draft-panel
  >
    <div class="pointer-events-auto rounded-lg border border-ink-200 bg-white p-4 shadow-xl">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Order Approval</p>
          <h3 class="mt-1 truncate text-sm font-bold text-ink-900" data-order-draft-title></h3>
        </div>
        <button type="button" class="rounded-md px-2 py-1 text-xs text-ink-500 hover:bg-ink-50" data-order-draft-close>닫기</button>
      </div>
      <dl class="mt-3 grid grid-cols-2 gap-2 text-xs">
        <div>
          <dt class="text-ink-400">금액</dt>
          <dd class="font-semibold text-ink-800" data-order-draft-notional></dd>
        </div>
        <div>
          <dt class="text-ink-400">범위</dt>
          <dd class="font-semibold text-ink-800" data-order-draft-scope></dd>
        </div>
      </dl>
      <ul class="mt-3 max-h-32 space-y-1 overflow-y-auto text-xs text-ink-700" data-order-draft-list></ul>
      <p class="mt-3 rounded-md bg-amber-50 px-3 py-2 text-xs leading-relaxed text-amber-800" data-order-draft-risk></p>
      <button
        type="button"
        class="mt-3 h-10 w-full rounded-md bg-ink-900 px-3 text-sm font-semibold text-white hover:bg-ink-800 disabled:cursor-not-allowed disabled:bg-ink-300"
        data-order-draft-submit
      >주문 승인</button>
      <p class="mt-2 hidden text-xs text-ink-500" data-order-draft-status></p>
    </div>
  </aside>
  <aside
    class="pointer-events-none fixed bottom-4 left-4 z-40 hidden w-[min(440px,calc(100vw-2rem))]"
    data-config-draft-panel
  >
    <div class="pointer-events-auto rounded-lg border border-blue-200 bg-white p-4 shadow-xl">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">Config Approval</p>
          <h3 class="mt-1 truncate text-sm font-bold text-ink-900" data-config-draft-title></h3>
        </div>
        <button type="button" class="rounded-md px-2 py-1 text-xs text-ink-500 hover:bg-ink-50" data-config-draft-close>닫기</button>
      </div>
      <p class="mt-3 rounded-md bg-blue-50 px-3 py-2 text-xs leading-relaxed text-blue-900" data-config-draft-summary></p>
      <ul class="mt-3 max-h-28 space-y-1 overflow-y-auto text-xs text-ink-600" data-config-draft-diffs></ul>
      <button
        type="button"
        class="mt-3 h-10 w-full rounded-md bg-blue-700 px-3 text-sm font-semibold text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-ink-300"
        data-config-draft-apply
      >설정 변경 승인</button>
      <p class="mt-2 hidden text-xs text-ink-500" data-config-draft-status></p>
    </div>
  </aside>
  <aside
    class="fixed inset-0 z-50 hidden bg-ink-950/45 px-4 py-5 sm:px-6"
    data-credential-draft-panel
    role="dialog"
    aria-modal="true"
  >
    <div class="flex min-h-full items-center justify-center">
      <div class="w-full max-w-lg rounded-lg border border-emerald-200 bg-white p-4 shadow-2xl sm:p-5 max-h-[calc(100dvh-2.5rem)] overflow-y-auto">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Credential Approval</p>
            <h3 class="mt-1 truncate text-sm font-bold text-ink-900" data-credential-draft-title></h3>
          </div>
          <button type="button" class="rounded-md px-2 py-1 text-xs text-ink-500 hover:bg-ink-50" data-credential-draft-close>닫기</button>
        </div>
        <p class="mt-3 rounded-md bg-emerald-50 px-3 py-2 text-xs leading-relaxed text-emerald-900" data-credential-draft-summary></p>
        <div class="mt-3 flex flex-col gap-2 rounded-md border border-ink-200 bg-ink-50 px-3 py-2 text-xs leading-relaxed text-ink-600 sm:flex-row sm:items-center sm:justify-between">
          <span data-credential-help-text>발급 페이지에서 key를 만든 뒤 이 창에만 입력하세요.</span>
          <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer" class="font-semibold text-emerald-700 hover:text-emerald-900" data-credential-help-link>API key 발급</a>
        </div>
        <form class="mt-3 space-y-3" data-credential-draft-form>
          <input type="hidden" name="tenant_id" value="{{ tenant }}"/>
          <label class="block text-xs font-semibold text-ink-600" data-credential-key-field>
            API key
            <input name="api_key" type="password" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off" data-credential-api-key/>
          </label>
          <button type="button" class="hidden h-10 w-full rounded-md border border-ink-300 bg-white px-3 text-sm font-semibold text-ink-800 hover:bg-ink-50 disabled:cursor-not-allowed disabled:bg-ink-100" data-credential-model-lookup>모델 조회</button>
          <div class="hidden space-y-3" data-credential-model-fields>
            <label class="block text-xs font-semibold text-ink-600">
              Advisor model
              <select name="model" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 font-mono text-xs text-ink-900" data-credential-advisor-model disabled></select>
            </label>
            <label class="block text-xs font-semibold text-ink-600">
              Router / utility model
              <select name="cheap_model" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 font-mono text-xs text-ink-900" data-credential-cheap-model disabled></select>
            </label>
          </div>
          <div class="hidden space-y-3" data-credential-kis-fields>
            <label class="block text-xs font-semibold text-ink-600">
              투자 환경
              <select name="kis_env" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" data-credential-kis-env>
                <option value="demo">모의투자</option>
                <option value="real">실전투자</option>
              </select>
            </label>
            <label class="block text-xs font-semibold text-ink-600">
              계좌번호
              <input name="kis_account_no" inputmode="numeric" placeholder="12345678-01" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off" data-credential-kis-account-no/>
            </label>
            <div class="space-y-3" data-credential-kis-paper-fields>
              <label class="block text-xs font-semibold text-ink-600">
                모의투자 APP KEY
                <input name="kis_paper_app_key" type="password" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off" data-credential-kis-paper-app-key/>
              </label>
              <label class="block text-xs font-semibold text-ink-600">
                모의투자 APP SECRET
                <input name="kis_paper_app_secret" type="password" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off" data-credential-kis-paper-app-secret/>
              </label>
            </div>
            <div class="hidden space-y-3" data-credential-kis-real-fields>
              <label class="block text-xs font-semibold text-ink-600">
                실전투자 APP KEY
                <input name="kis_app_key" type="password" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off" data-credential-kis-app-key/>
              </label>
              <label class="block text-xs font-semibold text-ink-600">
                실전투자 APP SECRET
                <input name="kis_app_secret" type="password" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off" data-credential-kis-app-secret/>
              </label>
            </div>
          </div>
          <label class="hidden items-start gap-2 rounded-md bg-red-50 px-3 py-2 text-xs leading-relaxed text-red-800" data-credential-confirm-field>
            <input name="confirmed" value="true" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-red-300" data-credential-confirm/>
            <span data-credential-confirm-copy>이 provider의 저장된 LLM API key를 삭제합니다.</span>
          </label>
          <button
            type="submit"
            class="h-10 w-full rounded-md bg-emerald-700 px-3 text-sm font-semibold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:bg-ink-300"
            data-credential-draft-apply
          >승인</button>
        </form>
        <p class="mt-2 hidden text-xs text-ink-500" data-credential-draft-status></p>
      </div>
    </div>
  </aside>
  {% else %}
  <div class="flex flex-1 items-center justify-center px-6">
    <div class="w-full max-w-md rounded-lg border border-ink-200 bg-white p-5 text-sm leading-relaxed text-ink-800 shadow-sm" data-llm-key-panel>
      <h2 class="text-base font-bold text-ink-950">LLM API key 연결</h2>
      <p class="mt-2 text-sm text-ink-600">투자챗봇을 시작하려면 먼저 사용할 LLM provider의 API key를 저장해야 합니다.</p>
      <p class="mt-3 rounded-md bg-ink-50 px-3 py-2 text-xs leading-relaxed text-ink-600">
        <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer" class="font-semibold text-ink-900 hover:text-emerald-700" data-llm-key-help-link>API key 발급 페이지</a>에서 key를 만든 뒤 이 화면에만 입력하세요.
      </p>
      {% if not llm_key_store_available %}
      <p class="mt-3 rounded-md bg-red-50 px-3 py-2 text-xs text-red-700">Credential store unavailable: {{ llm_key_store_error }}</p>
      {% endif %}
      <form method="post" action="/investment-chat/model-key" class="mt-4 space-y-3" data-llm-key-form>
        <input type="hidden" name="tenant_id" value="{{ tenant }}"/>
        <label class="block text-xs font-semibold text-ink-600">
          Provider
          <select name="provider" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" data-llm-key-provider>
            {% for item in llm_key_provider_options %}
            <option value="{{ item.value }}" {% if item.selected %}selected{% endif %}>{{ item.label }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="block text-xs font-semibold text-ink-600">
          API key
          <input name="api_key" type="password" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 text-sm text-ink-900" autocomplete="off"/>
        </label>
        <button type="button" class="h-10 w-full rounded-md border border-ink-300 bg-white px-3 text-sm font-semibold text-ink-800 hover:bg-ink-50 disabled:cursor-not-allowed disabled:bg-ink-100" data-llm-key-options-button {% if not llm_key_store_available %}disabled{% endif %}>모델 조회</button>
        <div class="hidden space-y-3" data-llm-key-model-step>
          <label class="block text-xs font-semibold text-ink-600">
            Advisor model
            <select name="model" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 font-mono text-xs text-ink-900" data-llm-key-model="advisor" disabled></select>
          </label>
          <label class="block text-xs font-semibold text-ink-600">
            Router / utility model
            <select name="cheap_model" class="mt-1 h-10 w-full rounded-md border border-ink-200 bg-white px-2 font-mono text-xs text-ink-900" data-llm-key-model="cheap" disabled></select>
          </label>
        </div>
        <p class="hidden rounded-md px-3 py-2 text-xs" data-llm-key-options-status></p>
        <button type="submit" class="h-10 w-full rounded-md bg-ink-900 px-3 text-sm font-semibold text-white hover:bg-ink-800 disabled:cursor-not-allowed disabled:bg-ink-300" {% if not llm_key_store_available %}disabled{% endif %}>저장하고 투자챗봇 시작</button>
      </form>
    </div>
  </div>
  {% endif %}
</section>
<script type="application/json" id="investment-chat-key-help-map">{{ llm_key_help_urls | tojson }}</script>
<script type="application/json" id="investment-chat-kis-help-url">{{ kis_key_help_url | tojson }}</script>
<script>
  (function() {
    var helpRaw = document.getElementById('investment-chat-key-help-map');
    var helpUrls = {};
    try { helpUrls = JSON.parse(helpRaw && helpRaw.textContent || '{}') || {}; } catch (_err) { helpUrls = {}; }
    document.querySelectorAll('[data-llm-key-provider]').forEach(function(provider) {
      var form = provider.closest('form');
      var model = form && form.querySelector('[data-llm-key-model="advisor"]');
      var cheapModel = form && form.querySelector('[data-llm-key-model="cheap"]');
      var apiKey = form && form.querySelector('input[name="api_key"]');
      var lookupButton = form && form.querySelector('[data-llm-key-options-button]');
      var modelStep = form && form.querySelector('[data-llm-key-model-step]');
      var status = form && form.querySelector('[data-llm-key-options-status]');
      var submitButton = form && form.querySelector('button[type="submit"]');
      var helpLink = form && form.parentNode && form.parentNode.querySelector('[data-llm-key-help-link]');
      function fill(select, values) {
        if (!select) return;
        select.innerHTML = '';
        values.forEach(function(v) {
          var opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          select.appendChild(opt);
        });
        if (values.length) select.value = values[0];
        select.disabled = !values.length;
      }
      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.classList.toggle('hidden', !message);
        status.classList.toggle('bg-emerald-50', !!ok);
        status.classList.toggle('text-emerald-700', !!ok);
        status.classList.toggle('bg-red-50', !!message && !ok);
        status.classList.toggle('text-red-700', !!message && !ok);
      }
      function hideModels() {
        fill(model, []);
        fill(cheapModel, []);
        if (modelStep) modelStep.classList.add('hidden');
      }
      function syncHelpLink() {
        if (!helpLink) return;
        helpLink.href = helpUrls[provider.value] || 'https://platform.openai.com/api-keys';
      }
      if (!model || !cheapModel) return;
      provider.addEventListener('change', function() {
        syncHelpLink();
        hideModels();
        setStatus('', false);
      });
      if (apiKey) apiKey.addEventListener('input', function() { hideModels(); setStatus('', false); });
      if (lookupButton) lookupButton.addEventListener('click', function() {
        if (!apiKey || !apiKey.value.trim()) {
          setStatus('API key를 입력한 뒤 모델을 조회하세요.', false);
          return;
        }
        var data = new FormData(form);
        lookupButton.disabled = true;
        setStatus('모델 목록을 조회하고 있습니다.', true);
        fetch('/investment-chat/model-key/options', { method: 'POST', body: data, credentials: 'same-origin' })
          .then(function(res) { return res.json().then(function(payload) { return { ok: res.ok, payload: payload }; }); })
          .then(function(result) {
            if (!result.ok) throw new Error(result.payload && result.payload.error || '모델 조회에 실패했습니다.');
            var advisorModels = result.payload.advisor_models || [];
            var cheapModels = result.payload.router_models || result.payload.utility_models || [];
            fill(model, advisorModels);
            fill(cheapModel, cheapModels);
            if (modelStep) modelStep.classList.remove('hidden');
            setStatus('모델 목록을 불러왔습니다.', true);
          })
          .catch(function(err) {
            hideModels();
            setStatus(err && err.message || '모델 조회에 실패했습니다.', false);
          })
          .finally(function() { lookupButton.disabled = false; });
      });
      if (form) form.addEventListener('submit', function(event) {
        if ((model && model.disabled) || (cheapModel && cheapModel.disabled)) {
          event.preventDefault();
          setStatus('모델 조회 후 저장할 모델을 선택하세요.', false);
        }
      });
      syncHelpLink();
    });
  })();
</script>
{% if iframe_src %}
<script>
  (function() {
    function adkFrame() {
      return document.querySelector('[data-adk-chat-frame]');
    }

    function adkFrameDocument() {
      var frame = adkFrame();
      try {
        return frame && (frame.contentDocument || (frame.contentWindow && frame.contentWindow.document));
      } catch (_err) {
        return null;
      }
    }

    function removeStaleAdkDrawerStabilizer(attempt) {
      var tries = Number(attempt || 0);
      var doc = adkFrameDocument();
      if (!doc || !doc.head) {
        if (tries < 40) {
          window.setTimeout(function() { removeStaleAdkDrawerStabilizer(tries + 1); }, 250);
        }
        return false;
      }
      var stale = doc.getElementById('arena-adk-drawer-stabilizer');
      if (stale && stale.parentNode) {
        stale.parentNode.removeChild(stale);
      }
      return true;
    }

    function installWhenReady(attempt) {
      var tries = Number(attempt || 0);
      var doc = adkFrameDocument();
      if (doc && doc.head) {
        removeStaleAdkDrawerStabilizer(0);
        return;
      }
      if (tries < 40) {
        window.setTimeout(function() { installWhenReady(tries + 1); }, 250);
      }
    }

    var frame = adkFrame();
    if (frame) {
      frame.addEventListener('load', function() {
        installWhenReady(0);
      });
      installWhenReady(0);
    }
  })();

  (function() {
    var lists = Array.prototype.slice.call(document.querySelectorAll('[data-chat-session-list]'));
    var statuses = Array.prototype.slice.call(document.querySelectorAll('[data-chat-session-status]'));
    if (!lists.length) return;

    var appName = {{ chat_session_app_name | tojson }};
    var userId = {{ chat_session_user_id | tojson }};
    var iframeBaseSrc = {{ iframe_src | tojson }};
    var currentSessionId = '';
    var lastListLoadAt = 0;

    function frame() {
      return document.querySelector('[data-adk-chat-frame]');
    }

    function setStatus(text) {
      statuses.forEach(function(status) {
        status.textContent = text || '';
      });
    }

    function withIframeParams(params) {
      var url = new URL(iframeBaseSrc, window.location.origin);
      Object.keys(params || {}).forEach(function(key) {
        var value = params[key];
        if (value === null || value === undefined || value === '') {
          url.searchParams.delete(key);
        } else {
          url.searchParams.set(key, value);
        }
      });
      url.searchParams.set('_session_v', String(Date.now()));
      return url.pathname + url.search + url.hash;
    }

    function closeMainSidebarOnMobile() {
      if (window.innerWidth >= 768) return;
      var sidebar = document.getElementById('arena-sidebar');
      var backdrop = document.getElementById('sidebar-backdrop');
      if (sidebar) sidebar.classList.remove('open');
      if (backdrop) backdrop.classList.remove('open');
    }

    function setSessionTreeOpen(open) {
      document.querySelectorAll('[data-chat-session-nav]').forEach(function(nav) {
        nav.dataset.open = open ? 'true' : 'false';
      });
      document.querySelectorAll('[data-chat-session-tree-toggle]').forEach(function(button) {
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        button.setAttribute('aria-label', open ? '투자챗봇 대화 목록 닫기' : '투자챗봇 대화 목록 열기');
      });
    }

    function sessionTitle(session) {
      var state = session && session.state;
      var metadata = state && (state.session_metadata || state.__session_metadata__);
      var title = metadata && metadata.displayName;
      title = String(title || '').trim();
      if (title) return title;
      var id = String(session && session.id || '').trim();
      return id ? ('대화 ' + id.slice(0, 8)) : '새 대화';
    }

    function sessionTime(session) {
      var raw = Number(session && (session.lastUpdateTime || session.updateTime || session.createTime) || 0);
      if (!isFinite(raw) || raw <= 0) return '';
      var millis = raw > 1000000000000 ? raw : raw * 1000;
      try {
        return new Intl.DateTimeFormat('ko-KR', {
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        }).format(new Date(millis));
      } catch (_err) {
        return '';
      }
    }

    function setActiveSession(sessionId) {
      currentSessionId = String(sessionId || '');
      document.querySelectorAll('[data-chat-session-id]').forEach(function(item) {
        var active = item.getAttribute('data-chat-session-id') === currentSessionId;
        item.setAttribute('aria-current', active ? 'page' : 'false');
        item.classList.toggle('bg-white', active);
        item.classList.toggle('shadow-sm', active);
        item.classList.toggle('text-ink-950', active);
      });
    }

    function renderSessions(sessions) {
      var rows = (sessions || []).slice().sort(function(a, b) {
        return Number(b.lastUpdateTime || 0) - Number(a.lastUpdateTime || 0);
      });
      lists.forEach(function(list) {
        list.innerHTML = '';
        if (!rows.length) {
          var empty = document.createElement('p');
          empty.className = 'px-2 py-2 text-xs text-ink-500';
          empty.textContent = '저장된 대화가 없습니다.';
          list.appendChild(empty);
          return;
        }
        rows.forEach(function(session) {
          var id = String(session && session.id || '').trim();
          if (!id) return;
          var button = document.createElement('button');
          button.type = 'button';
          button.className = list.closest('[data-chat-session-nav]')
            ? 'chat-session-item'
            : 'mb-1 flex w-full flex-col rounded-md px-3 py-2 text-left text-sm text-ink-700 hover:bg-white';
          button.setAttribute('data-chat-session-id', id);
          button.setAttribute('aria-current', 'false');

          var title = document.createElement('span');
          title.className = list.closest('[data-chat-session-nav]') ? 'chat-session-title' : 'w-full truncate font-semibold';
          title.textContent = sessionTitle(session);
          button.appendChild(title);

          var time = sessionTime(session);
          if (time) {
            var meta = document.createElement('span');
            meta.className = list.closest('[data-chat-session-nav]') ? 'chat-session-meta' : 'mt-1 text-[11px] text-ink-400';
            meta.textContent = time;
            button.appendChild(meta);
          }

          button.addEventListener('click', function() {
            openSession(id);
          });
          list.appendChild(button);
        });
      });
      setActiveSession(currentSessionId);
    }

    function loadChatSessions(force) {
      if (!appName || !userId) return Promise.resolve();
      var now = Date.now();
      if (!force && now - lastListLoadAt < 15000) return Promise.resolve();
      lastListLoadAt = now;
      setStatus('동기화 중');
      var url = '/investment-chat/adk/apps/' + encodeURIComponent(appName) + '/users/' + encodeURIComponent(userId) + '/sessions';
      return fetch(url, {credentials: 'same-origin'})
        .then(function(resp) {
          if (!resp.ok) throw new Error('session list failed');
          return resp.json();
        })
        .then(function(payload) {
          var sessions = Array.isArray(payload) ? payload : (payload && payload.items || []);
          renderSessions(sessions);
          setStatus(sessions.length ? (sessions.length + '개') : '');
        })
        .catch(function() {
          setStatus('불러오기 실패');
        });
    }

    function openSession(sessionId) {
      var targetFrame = frame();
      if (!targetFrame) return;
      setActiveSession(sessionId);
      targetFrame.src = withIframeParams({session: sessionId, userId: userId});
      closeMainSidebarOnMobile();
    }

    function startNewSession() {
      var targetFrame = frame();
      if (!targetFrame) return;
      setActiveSession('');
      targetFrame.src = withIframeParams({session: '', userId: userId});
      closeMainSidebarOnMobile();
    }

    function syncActiveSessionFromFrame() {
      var targetFrame = frame();
      try {
        var href = targetFrame && targetFrame.contentWindow && targetFrame.contentWindow.location.href;
        if (!href) return;
        var url = new URL(href);
        var sessionId = url.searchParams.get('session') || '';
        if (sessionId && sessionId !== currentSessionId) {
          setActiveSession(sessionId);
          loadChatSessions(true);
        }
      } catch (_err) {}
    }

    window.loadChatSessions = loadChatSessions;
    document.querySelectorAll('[data-chat-session-new]').forEach(function(button) {
      button.addEventListener('click', startNewSession);
    });
    document.querySelectorAll('[data-chat-session-refresh]').forEach(function(button) {
      button.addEventListener('click', function() { loadChatSessions(true); });
    });
    document.querySelectorAll('[data-chat-session-tree-toggle]').forEach(function(button) {
      button.addEventListener('click', function() {
        var expanded = button.getAttribute('aria-expanded') === 'true';
        setSessionTreeOpen(!expanded);
      });
    });
    var targetFrame = frame();
    if (targetFrame) {
      targetFrame.addEventListener('load', function() {
        syncActiveSessionFromFrame();
      });
    }
    loadChatSessions(true);
    window.setInterval(syncActiveSessionFromFrame, 2000);
    window.addEventListener('focus', function() { loadChatSessions(false); });
  })();

  (function() {
    var tenant = {{ tenant | tojson }};
    var panel = document.querySelector('[data-order-draft-panel]');
    if (!panel) return;
    var title = panel.querySelector('[data-order-draft-title]');
    var notional = panel.querySelector('[data-order-draft-notional]');
    var scope = panel.querySelector('[data-order-draft-scope]');
    var draftList = panel.querySelector('[data-order-draft-list]');
    var risk = panel.querySelector('[data-order-draft-risk]');
    var submit = panel.querySelector('[data-order-draft-submit]');
    var status = panel.querySelector('[data-order-draft-status]');
    var close = panel.querySelector('[data-order-draft-close]');
    var activeTokens = [];
    var activeAllTokens = [];
    var activeBatchToken = '';
    var dismissed = {};

    function fmtKrw(value) {
      var number = Number(value || 0);
      if (!isFinite(number)) return '-';
      return Math.round(number).toLocaleString('ko-KR') + '원';
    }

    function setStatus(text) {
      if (!status) return;
      status.textContent = text || '';
      status.classList.toggle('hidden', !text);
    }

    function submitResultMessage(body) {
      var reportMessage = body && body.execution_report && body.execution_report.message;
      return body && (body.message || body.error) || reportMessage || ('status=' + (body && body.status || 'unknown'));
    }

    function submittableDrafts(drafts) {
      return (drafts || []).filter(function(item) { return item && item.submittable && item.approval_token; });
    }

    function draftCreatedMillis(draft) {
      var raw = String(draft && draft.created_at || '').trim();
      if (!raw) return 0;
      var millis = Date.parse(raw);
      return isFinite(millis) ? millis : 0;
    }

    function visibleDraftGroup(drafts) {
      var visible = (drafts || []).filter(function(item) {
        return item && item.approval_token && !dismissed[item.approval_token] && ['draft', 'risk_rejected'].indexOf(String(item.status || '')) >= 0;
      });
      if (!visible.length) return [];
      var first = visible[0];
      var batchToken = String(first.batch_token || '');
      if (batchToken) {
        return visible.filter(function(item) { return String(item.batch_token || '') === batchToken; });
      }
      var firstMillis = draftCreatedMillis(first);
      if (!firstMillis) return [first];
      return visible.filter(function(item) {
        return !String(item.batch_token || '') && Math.abs(draftCreatedMillis(item) - firstMillis) <= 10000;
      });
    }

    function isAdkChatBusy(doc) {
      return !!(
        doc &&
        (
          doc.querySelector('mat-progress-bar') ||
          doc.querySelector('.agent-loading-indicator') ||
          doc.querySelector('[role="progressbar"]')
        )
      );
    }

    function deliverOrderResultToChat(text, attempt) {
      var message = String(text || '').trim();
      if (!message) return false;
      var tries = Number(attempt || 0);
      var frame = document.querySelector('[data-adk-chat-frame]');
      if (!frame) return false;
      var doc = null;
      try {
        doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
      } catch (_err) {
        return false;
      }
      if (isAdkChatBusy(doc)) {
        if (tries < 80) {
          window.setTimeout(function() { deliverOrderResultToChat(message, tries + 1); }, 500);
        }
        return false;
      }
      var textarea = doc && doc.querySelector('textarea.chat-input-box');
      var sendButton = doc && doc.querySelector('button.send-message-btn');
      if (!textarea || !sendButton) {
        if (tries < 80) {
          window.setTimeout(function() { deliverOrderResultToChat(message, tries + 1); }, 500);
        }
        return false;
      }
      var EventCtor = (doc.defaultView && doc.defaultView.Event) || Event;
      textarea.focus();
      textarea.value = message;
      textarea.dispatchEvent(new EventCtor('input', {bubbles: true}));
      textarea.dispatchEvent(new EventCtor('change', {bubbles: true}));
      sendButton.click();
      return true;
    }

    function deliverSubmitResult(body) {
      return deliverOrderResultToChat(body && body.chat_delivery_text);
    }

    function renderDrafts(drafts) {
      drafts = (drafts || []).filter(function(item) { return item && item.approval_token; });
      if (!drafts.length) return;
      var submittable = submittableDrafts(drafts);
      activeTokens = submittable.map(function(item) { return item.approval_token; });
      activeAllTokens = drafts.map(function(item) { return item.approval_token; });
      activeBatchToken = String(drafts[0].batch_token || '');
      var total = submittable.reduce(function(sum, draft) {
        var intent = draft.intent || {};
        return sum + Number(draft.notional_krw || intent.price_krw * intent.quantity || 0);
      }, 0);
      if (drafts.length === 1) {
        var intent = drafts[0].intent || {};
        var side = String(intent.side || '').toUpperCase();
        title.textContent = [intent.ticker, side, intent.quantity ? ('x ' + intent.quantity) : ''].filter(Boolean).join(' ');
      } else {
        title.textContent = '주문 ' + drafts.length + '건 일괄 승인';
      }
      notional.textContent = fmtKrw(total);
      var scopes = drafts.map(function(item) { return String(item.scope || 'account'); });
      scope.textContent = scopes.every(function(item) { return item === scopes[0]; }) ? scopes[0] : 'mixed';
      if (draftList) {
        draftList.innerHTML = '';
        drafts.forEach(function(draft) {
          var intent = draft.intent || {};
          var riskObj = draft.risk || {};
          var hits = riskObj.policy_hits || [];
          var item = document.createElement('li');
          item.className = 'flex items-center justify-between gap-3 rounded-md bg-ink-50 px-2 py-1';
          var label = document.createElement('span');
          label.className = 'min-w-0 truncate font-semibold';
          label.textContent = [intent.ticker, String(intent.side || '').toUpperCase(), intent.quantity ? (intent.quantity + '주') : ''].filter(Boolean).join(' ');
          var state = document.createElement('span');
          state.className = draft.submittable ? 'shrink-0 text-emerald-700' : 'shrink-0 text-amber-700';
          state.textContent = draft.submittable ? '가능' : (hits.length ? hits.join(', ') : draft.status);
          item.appendChild(label);
          item.appendChild(state);
          draftList.appendChild(item);
        });
      }
      if (submittable.length) {
        risk.textContent = drafts.length === 1
          ? '리스크 검증 통과. 버튼을 누르면 저장된 주문 초안을 제출합니다.'
          : ('리스크 검증을 통과한 주문 ' + submittable.length + '건을 한 번에 제출합니다.');
      } else {
        var firstRisk = drafts[0].risk || {};
        var firstHits = firstRisk.policy_hits || [];
        risk.textContent = '제출 불가: ' + (firstHits.length ? firstHits.join(', ') : drafts[0].status);
      }
      submit.disabled = !submittable.length;
      submit.textContent = drafts.length === 1 ? '주문 승인' : ('주문 ' + submittable.length + '건 승인');
      setStatus('');
      panel.classList.remove('hidden');
    }

    function pollDrafts() {
      fetch('/investment-chat/order-drafts?tenant_id=' + encodeURIComponent(tenant), {credentials: 'same-origin'})
        .then(function(resp) { return resp.ok ? resp.json() : null; })
        .then(function(payload) {
          var drafts = payload && payload.drafts || [];
          var visible = visibleDraftGroup(drafts);
          if (visible.length) renderDrafts(visible);
        })
        .catch(function() {});
    }

    if (close) {
      close.addEventListener('click', function() {
        activeAllTokens.forEach(function(token) { dismissed[token] = true; });
        panel.classList.add('hidden');
      });
    }
    if (submit) {
      submit.addEventListener('click', function() {
        if (!activeTokens.length || submit.disabled) return;
        submit.disabled = true;
        setStatus('제출 중...');
        var batch = activeTokens.length > 1;
        var url = batch
          ? ('/investment-chat/order-drafts/batch-submit?tenant_id=' + encodeURIComponent(tenant))
          : ('/investment-chat/order-drafts/' + encodeURIComponent(activeTokens[0]) + '/submit?tenant_id=' + encodeURIComponent(tenant));
        var options = {
          method: 'POST',
          credentials: 'same-origin'
        };
        if (batch) {
          options.headers = {'Content-Type': 'application/json'};
          options.body = JSON.stringify({approval_tokens: activeTokens, batch_token: activeBatchToken});
        }
        fetch(url, options)
          .then(function(resp) { return resp.json().then(function(body) { return {ok: resp.ok, body: body}; }); })
          .then(function(result) {
            var body = result.body || {};
            if (body.status === 'submitted' || body.status === 'already_submitted' || body.status === 'partial') {
              setStatus(body.status === 'partial' ? '일부 제출 완료' : (body.status === 'already_submitted' ? '이미 제출된 주문입니다.' : '제출 완료'));
              deliverSubmitResult(body);
              activeAllTokens.forEach(function(token) { dismissed[token] = true; });
              window.setTimeout(function() { panel.classList.add('hidden'); }, 1200);
            } else {
              submit.disabled = false;
              deliverSubmitResult(body);
              setStatus('제출 실패: ' + submitResultMessage(body));
            }
          })
          .catch(function() {
            submit.disabled = false;
            setStatus('제출 실패');
          });
      });
    }

    pollDrafts();
    window.setInterval(pollDrafts, 2500);
  })();
</script>
<script>
  (function() {
    var tenant = {{ tenant | tojson }};
    var panel = document.querySelector('[data-config-draft-panel]');
    if (!panel) return;
    var title = panel.querySelector('[data-config-draft-title]');
    var summary = panel.querySelector('[data-config-draft-summary]');
    var diffs = panel.querySelector('[data-config-draft-diffs]');
    var apply = panel.querySelector('[data-config-draft-apply]');
    var status = panel.querySelector('[data-config-draft-status]');
    var close = panel.querySelector('[data-config-draft-close]');
    var activeToken = '';
    var dismissed = {};

    function setConfigStatus(text) {
      if (!status) return;
      status.textContent = text || '';
      status.classList.toggle('hidden', !text);
    }

    function renderValue(value) {
      if (value === null || value === undefined || value === '') return '-';
      if (typeof value === 'object') {
        try { return JSON.stringify(value); } catch (_err) { return String(value); }
      }
      return String(value);
    }

    function deliverConfigResultToChat(text, attempt) {
      var message = String(text || '').trim();
      if (!message) return false;
      var tries = Number(attempt || 0);
      var frame = document.querySelector('[data-adk-chat-frame]');
      var doc = null;
      try {
        doc = frame && (frame.contentDocument || (frame.contentWindow && frame.contentWindow.document));
      } catch (_err) {
        return false;
      }
      var textarea = doc && doc.querySelector('textarea.chat-input-box');
      var sendButton = doc && doc.querySelector('button.send-message-btn');
      if (!textarea || !sendButton) {
        if (tries < 80) {
          window.setTimeout(function() { deliverConfigResultToChat(message, tries + 1); }, 500);
        }
        return false;
      }
      var EventCtor = (doc.defaultView && doc.defaultView.Event) || Event;
      textarea.focus();
      textarea.value = message;
      textarea.dispatchEvent(new EventCtor('input', {bubbles: true}));
      textarea.dispatchEvent(new EventCtor('change', {bubbles: true}));
      sendButton.click();
      return true;
    }

    function renderConfigDraft(draft) {
      if (!draft || !draft.approval_token) return;
      activeToken = draft.approval_token;
      title.textContent = draft.scope ? (draft.scope + ' 설정 변경') : '설정 변경';
      summary.textContent = draft.summary || '설정 변경 초안';
      diffs.innerHTML = '';
      (draft.diffs || []).slice(0, 8).forEach(function(diff) {
        var li = document.createElement('li');
        li.className = 'rounded bg-ink-50 px-2 py-1';
        li.textContent = String(diff.field || 'field') + ': ' + renderValue(diff.before) + ' -> ' + renderValue(diff.after);
        diffs.appendChild(li);
      });
      apply.disabled = !draft.submittable;
      setConfigStatus('');
      panel.classList.remove('hidden');
    }

    function pollConfigDrafts() {
      fetch('/investment-chat/config-drafts?tenant_id=' + encodeURIComponent(tenant), {credentials: 'same-origin'})
        .then(function(resp) { return resp.ok ? resp.json() : null; })
        .then(function(payload) {
          var drafts = payload && payload.drafts || [];
          var draft = drafts.find(function(item) {
            return item && item.approval_token && !dismissed[item.approval_token] && String(item.status || '') === 'draft';
          });
          if (draft) renderConfigDraft(draft);
        })
        .catch(function() {});
    }

    if (close) {
      close.addEventListener('click', function() {
        if (activeToken) dismissed[activeToken] = true;
        panel.classList.add('hidden');
      });
    }
    if (apply) {
      apply.addEventListener('click', function() {
        if (!activeToken || apply.disabled) return;
        apply.disabled = true;
        setConfigStatus('적용 중...');
        fetch('/investment-chat/config-drafts/' + encodeURIComponent(activeToken) + '/apply?tenant_id=' + encodeURIComponent(tenant), {
          method: 'POST',
          credentials: 'same-origin'
        })
          .then(function(resp) { return resp.json().then(function(body) { return {ok: resp.ok, body: body}; }); })
          .then(function(result) {
            var body = result.body || {};
            if (body.status === 'applied' || body.status === 'already_applied') {
              setConfigStatus(body.status === 'already_applied' ? '이미 적용된 설정입니다.' : '적용 완료');
              deliverConfigResultToChat(body.chat_delivery_text);
              dismissed[activeToken] = true;
              window.setTimeout(function() { panel.classList.add('hidden'); }, 1200);
            } else {
              apply.disabled = false;
              deliverConfigResultToChat(body.chat_delivery_text);
              setConfigStatus('적용 실패: ' + (body.error || body.message || body.status || 'unknown'));
            }
          })
          .catch(function() {
            apply.disabled = false;
            setConfigStatus('적용 실패');
          });
      });
    }

    pollConfigDrafts();
    window.setInterval(pollConfigDrafts, 2500);
  })();
